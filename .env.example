# Local example only: names, ports and delivery values are fictitious development settings.
# Passwords and encryption keys intentionally remain empty, never shared defaults.
# Generated secrets are written only to .env by scripts/init-local-env.mjs.
# Compose refuses to start with these empty passwords.
COMPOSE_PROJECT_NAME=bricocomptoir
POSTGRES_DB=bricocomptoir
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_USERNAME=brico_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=brico_migrator
DB_MIGRATION_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8080
FRONTEND_PORT=4200
MINIO_ROOT_USER=brico_local
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAIL_OUTBOX_KEY=
DATA_ARCHIVE_KEY=
# Legal retention must be validated by the operator. 0 blocks contact archival.
PRIVACY_LEGAL_DAYS=0
PRIVACY_RETENTION_ENABLED=false
PRIVACY_CONTACT_DAYS=90
PRIVACY_CART_DAYS=30
PRIVACY_MAIL_DAYS=30
PRIVACY_AUDIT_DAYS=365
# Demonstration values only, not validated commercial tariffs.
CHECKOUT_DELIVERY_FEE_TND=7.000
CHECKOUT_GOVERNORATES=TUNIS,SFAX
