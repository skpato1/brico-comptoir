# Documentation only. Inject real values using the deployment secret store.
# Local Docker Compose is NOT a production deployment configuration.
# Vercel build only: public HTTPS backend origin, no path or credentials.
# Empty until a backend is hosted; Vercel API requests then return 503.
BRICO_API_ORIGIN=
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://database-host:5432/bricocomptoir?sslmode=verify-full
DB_USERNAME=brico_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=brico_migrator
DB_MIGRATION_PASSWORD=
SERVER_PORT=8080
# Java regular expression matching ONLY the trusted ingress peer IP(s); keep backend private.
# Set this for your actual deployment, never .* or a public client range.
TRUSTED_PROXY_PATTERN=
SMTP_HOST=smtp-host
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=
# Preserve both independent Base64 32-byte keys with encrypted backups.
MAIL_OUTBOX_KEY=
DATA_ARCHIVE_KEY=
PRIVACY_LEGAL_DAYS=0
PRIVACY_RETENTION_ENABLED=false
PRIVACY_CONTACT_DAYS=90
PRIVACY_CART_DAYS=30
PRIVACY_MAIL_DAYS=30
PRIVACY_AUDIT_DAYS=365
MAIL_WORKER_ENABLED=true
APP_PUBLIC_URL=https://your-domain.example
MEDIA_ENDPOINT=https://private-object-store.example
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_BUCKET=bricocomptoir-media
# Required before checkout can open; no production tariff/zone default.
CHECKOUT_DELIVERY_FEE_TND=
CHECKOUT_GOVERNORATES=
